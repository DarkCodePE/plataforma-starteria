# Backend environment (copy to .env and fill)

# Runtime
NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/starteria_db

# Auth
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# HTTP
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT=1mb

AI_SERVICE_URL=http://localhost:8001

# Portfolio Entry live calls run in backend, independently of AI_SERVICE_URL.
# Configure the key as a deployment secret; never commit its value.
PORTFOLIO_ENTRY_RUNTIME_MODE=live
PORTFOLIO_ENTRY_PROVIDER=openai_responses
PORTFOLIO_ENTRY_MODEL=gpt-5.6-luna
PORTFOLIO_ENTRY_API_KEY=
PORTFOLIO_ENTRY_BASE_URL=https://api.openai.com/v1
PORTFOLIO_ENTRY_TIMEOUT_MS=30000
# Síntesis de la conclusión (Critical Handoff), procesada en segundo plano.
PORTFOLIO_ENTRY_SYNTHESIS_TIMEOUT_MS=120000
PORTFOLIO_ENTRY_CRITICAL_HANDOFF_MAX_MS=180000

# Bridge backend ↔ ai-service (V1 — shared secret only)
# TODO(ADR-011): replace with HMAC-SHA256 signing + timestamp + replay protection per TASK-007.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Same value MUST be configured in ai-service. Prefer AI_SERVICE_TOKEN; falls
# back to BRIDGE_SHARED_SECRET for backward compat. Pick ONE name and use it
# in both backend/.env and ai-service/.env.
BRIDGE_SHARED_SECRET=
AI_SERVICE_TOKEN=

# Storage (TASK-006 — local fs V1)
LOCAL_STORAGE_DIR=./storage

# --- Pilot lead email notification (PRD-003 / SPEC-003 / issue #54) ---
# SMTP transport for notifying the team when a new pilot lead is captured.
# If SMTP_HOST is unset, the notifier degrades to a non-PII log line (dev default).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# From address for outbound notifications (e.g. "Starteria <no-reply@tudominio.com>")
PILOT_LEAD_NOTIFY_FROM=
# Comma-separated recipient(s) that receive the new-lead notification (the team inbox).
PILOT_LEAD_NOTIFY_TO=

# 114E commercial owner mailbox. No destination is active in the default config.
# This setting alone never verifies or activates Demo/Early Access.
STARTERIA_COMMERCIAL_OWNER=
