# ============================================================================
# Stage 1: Build
# ============================================================================
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS builder

WORKDIR /app

# Install build dependencies needed for native modules (bcrypt)
RUN apk add --no-cache python3 make g++

# Copy package manifests and install ALL dependencies (including devDependencies
# needed for build: typescript, prisma CLI, tsx, @types/*)
COPY front/package.json front/package-lock.json ./
# package-lock.json resolves xlsx from a vendored tarball (file:vendor/...),
# so the vendor dir must land next to the manifests or `npm ci` fails ENOENT.
COPY front/vendor ./vendor

RUN npm ci

# Copy Prisma schema and generate the Prisma client
COPY front/prisma ./prisma/
RUN npx prisma generate

# Copy the backend TypeScript config and source code
COPY front/tsconfig.backend.json ./tsconfig.backend.json
COPY backend ./backend/

# Bundle TypeScript into a single file (skip type checking for deployment)
RUN npx esbuild backend/server.ts --bundle --outfile=dist/backend/server.js --platform=node --format=esm --target=es2022 --packages=external

# ============================================================================
# Stage 2: Production runtime
# ============================================================================
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS production

WORKDIR /app

ENV NODE_ENV=production

# Install runtime-only native build dependencies (bcrypt needs rebuild in clean image).
# The virtual package ensures the compiler toolchain is removed as one unit afterwards.
RUN apk add --no-cache --virtual .build-deps python3 make g++

# Copy package manifests and install production dependencies only
COPY front/package.json front/package-lock.json ./
# package-lock.json resolves xlsx from a vendored tarball (file:vendor/...),
# so the vendor dir must land next to the manifests or `npm ci` fails ENOENT.
COPY front/vendor ./vendor

RUN npm ci --omit=dev --omit=peer && \
    node -e "const fs=require('node:fs'); for (const path of ['node_modules/prisma','node_modules/@prisma/config','node_modules/deepmerge-ts','node_modules/c12','node_modules/defu','node_modules/effect','node_modules/typescript','node_modules/@vitejs','node_modules/@vitest']) fs.rmSync(path,{recursive:true,force:true})" && \
    npm cache clean --force && \
    rm -f package-lock.json /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack /usr/local/bin/yarn /usr/local/bin/yarnpkg && \
    rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack "/opt/yarn-v${YARN_VERSION}" /opt/yarn && \
    node -e "const fs=require('node:fs'); const forbidden=['node_modules/prisma','node_modules/@prisma/config','node_modules/deepmerge-ts','node_modules/c12','node_modules/defu','node_modules/effect','/usr/local/bin/yarn','/usr/local/bin/yarnpkg','/usr/local/lib/node_modules/corepack','/opt/yarn-v1.22.22']; const present=forbidden.filter(path=>fs.existsSync(path)); if(present.length) throw new Error('Forbidden runtime tooling remains: '+present.join(','))"

# Do not advertise a package manager that has been physically removed.
ENV YARN_VERSION=""

# Remove build tools and their transitive dependencies after native modules compile.
RUN apk del .build-deps

# The Prisma CLI is build/operations-only. Copy the generated Alpine client
# instead of shipping the vulnerable CLI/config dependency graph at runtime.
COPY --from=builder /app/node_modules/.prisma ./node_modules/.prisma

# Copy compiled JavaScript from the build stage
COPY --from=builder /app/dist/backend ./dist/backend/

# The prompt manifest is read at runtime with fs.readFileSync, not imported, so
# esbuild does not bundle it. In the bundle `promptsRoot` resolves to
# dirname(import.meta.url) + '/v0.2' -> /app/dist/backend/v0.2, so the files must
# land there. Without them loadResolvedPromptManifest() throws ENOENT and the
# runtime silently degrades to the Unconfigured adapter.
COPY backend/modules/portfolio-entry-runtime/prompts/v0.2 ./dist/backend/v0.2/

# Create a non-root user for security
RUN addgroup -g 1001 -S appgroup && \
    adduser -S appuser -u 1001 -G appgroup

# PDF auto-fill local storage (SPEC-002 / TASK-006). The compose file mounts
# /app/storage to a named volume `pdfstorage`. Pre-create with correct ownership
# so the non-root appuser can write.
RUN mkdir -p /app/storage && chown -R appuser:appgroup /app/storage

USER appuser

EXPOSE 3001

# Health check against the /api/health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -qO- http://localhost:3001/api/health || exit 1

CMD ["node", "dist/backend/server.js"]
