# Clones de referencia: son de otros proyectos, no de este
referencia/
token-optimizer/
diagram-design/
next-ai-draw-io/
hyperresearch/
gstack/
gbrain/
gbrain-evals/

# Configuración de herramientas, no del harness.
# Excepción: .claude/rules/ sí es del harness y se comparte con el equipo.
.claude/*
!.claude/rules/
# Flujo de trabajo del equipo (HU en Jira): agente planner y skill jira-hu.
!.claude/agents/
!.claude/skills/
.claude-flow/
.swarm/
estado/
.mcp.json
.hyperresearch/
.serena/

# Artefactos de herramientas
ruvector.db
agentdb.rvf*

# Bóveda de hyperresearch: caché de páginas ajenas, no entregable del harness.
# BENCHMARK.md cita las fuentes por URL, que es el registro que sí dura.
# Los informes finales quedan trackeables a propósito.
research/index/
research/raw/
research/temp/
research/runs/
research/notes/*
!research/notes/final_report_*.md

# Secretos: gbrain init escribe la clave del proveedor acá (ADR-010).
# Nunca se commitea; CLAUDE.md lo prohibe explicitamente.
.env
.env.*
!.env.example

# Resultados de las corridas de evals: son de cada corrida, no del harness
evals/results/

# Runtime dependencies and generated output
node_modules/
**/node_modules/
dist/
**/dist/
build/
**/build/
.vite/

# Runtime caches and test artifacts
coverage/
**/coverage/
**/coverage.xml
test-results/
playwright-report/
.nyc_output/
.npm-cache/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/__pycache__/
**/.coverage
**/.venv/
*.pyc
*.log
*.tmp

# Local runtime storage
backend/storage/
storage/
front/.pilot-dry-run/
docker-compose.override.yml

# Provider/client secrets
client_secret_*.json

# graft's local graph cache — regenerable, not committed (run `graft build`).
/graft/

# jev-ultrafast se clona localmente para scripts/jev-regresion.py (TESTING.md §9)
/jev-ultrafast/
