# Copy to preview.env outside Git only after infrastructure/security authorization.
# This template is intentionally safe: external email is disabled.
PREVIEW_HOST=preview.example.invalid
# Public IPv4 of the authorized preview host. The preflight checks the DNS A record.
PREVIEW_EXPECTED_IPV4=192.0.2.10
PREVIEW_DB_PASSWORD=REPLACE_WITH_SECRET
PREVIEW_JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
# Required edge gate. Use the fixed public egress IP/CIDR authorized by Security.
# Basic Auth is intentionally not used: it would overwrite the application's Bearer header.
PREVIEW_ALLOWED_CIDR=192.0.2.1/32
PREVIEW_BRIDGE_SHARED_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_SECRET
PREVIEW_AI_SERVICE_TOKEN=REPLACE_WITH_INDEPENDENT_32_BYTE_SECRET
PREVIEW_BILLING_WEBHOOK_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_SECRET
PREVIEW_PILOT_CODE_SECRET=REPLACE_WITH_INDEPENDENT_32_BYTE_SECRET
PREVIEW_LEAD_PASSWORD=REPLACE_WITH_SYNTHETIC_LEAD_PASSWORD
PREVIEW_OWNER_PASSWORD=REPLACE_WITH_SYNTHETIC_OWNER_PASSWORD
PREVIEW_MEMBER_PASSWORD=REPLACE_WITH_SYNTHETIC_MEMBER_PASSWORD

# Mail never leaves the private Docker network. Caddy exposes its UI behind the HTTPS CIDR gate.
HANDOFF_EMAIL_TRANSPORT_MODE=sandbox
HANDOFF_EMAIL_PILOT_ENABLED=false
HANDOFF_EMAIL_PILOT_VERIFIED_FROM=
HANDOFF_EMAIL_REPLY_TO=
HANDOFF_EMAIL_PILOT_RECIPIENT_ALLOWLIST=
HANDOFF_EMAIL_PILOT_ORGANIZATION_ALLOWLIST=
HANDOFF_EMAIL_PILOT_ACTOR_ALLOWLIST=
HANDOFF_EMAIL_PILOT_MAX_SENDS_PER_WINDOW=2
HANDOFF_EMAIL_PILOT_WINDOW_SECONDS=3600
HANDOFF_EMAIL_PILOT_MIN_INTERVAL_SECONDS=30
HANDOFF_INVITATION_TTL_HOURS=24
HANDOFF_INVITATION_MIN_TTL_HOURS=1
HANDOFF_INVITATION_MAX_TTL_HOURS=168
HANDOFF_EMAIL_MAX_BATCH_SIZE=25

# Sandbox defaults point to the private Mailpit service. Do not expose its UI.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
PILOT_LEAD_NOTIFY_FROM=Starteria Sandbox <sandbox@starteria.test>
