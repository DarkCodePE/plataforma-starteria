{
  "name": "@figma/my-make-file",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "set NODE_PATH=./node_modules&& tsx watch ../backend/server.ts",
    "dev:all": "concurrently \"npm run dev\" \"npm run dev:backend\"",
    "lint": "tsx scripts/lint-baseline.ts",
    "typecheck": "npm run typecheck:front && npm run typecheck:backend",
    "typecheck:front": "tsc -p tsconfig.front.json --noEmit",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "build": "vite build",
    "build:backend": "tsc -p tsconfig.backend.json",
    "start:backend": "node dist/backend/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:backfill-roles": "tsx scripts/backfill-user-roles.ts",
    "db:backfill-initiative-status": "tsx scripts/backfill-initiative-status.ts",
    "db:seed": "prisma db seed",
    "db:e2e:provision": "tsx scripts/database/provision-e2e-database.ts",
    "db:e2e:migrate": "tsx scripts/database/run-prisma-for-disposable-db.ts e2e migrate deploy",
    "db:e2e:seed": "tsx prisma/seed.e2e.ts",
    "db:e2e:status": "tsx scripts/database/run-prisma-for-disposable-db.ts e2e migrate status",
    "verify:initial-review": "tsx scripts/verify-initial-review-models.ts",
    "db:studio": "prisma studio",
    "db:reset": "prisma migrate reset",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "setup": "docker compose up -d && npm install && npx prisma generate && npx prisma db push && npx prisma db seed",
    "test": "npm run test:backend && npm run test:front",
    "test:watch": "vitest --config vitest.backend.config.ts",
    "test:backend": "vitest run --config vitest.backend.config.ts",
    "test:front": "vitest run --config vitest.front.config.ts",
    "test:coverage": "npm run test:coverage:backend && npm run test:coverage:front",
    "test:coverage:backend": "vitest run --config vitest.backend.config.ts --coverage",
    "test:coverage:front": "vitest run --config vitest.front.config.ts --coverage",
    "test:e2e": "tsx scripts/run-e2e.ts",
    "test:e2e:headed": "npm run test:e2e -- --headed",
    "test:e2e:debug": "npm run test:e2e -- --debug",
    "test:portfolio-steps": "tsx scripts/verify-portfolio-steps-integration.ts",
    "db:pilot:provision": "tsx scripts/database/provision-pilot-dry-run-database.ts",
    "db:pilot:migrate": "tsx scripts/database/run-prisma-for-disposable-db.ts pilot migrate deploy",
    "db:pilot:status": "tsx scripts/database/run-prisma-for-disposable-db.ts pilot migrate status",
    "db:pilot:seed": "tsx prisma/seed.pilot-dry-run.ts",
    "test:e2e:copilot": "npm run test:e2e -- e2e/portfolio-copilot-create-front.spec.ts",
    "test:e2e:portfolio": "npm run test:e2e -- e2e/portfolio-copilot-create-front.spec.ts e2e/portfolio-steps-integration.spec.ts",
    "test:e2e:steps": "npm run test:e2e -- e2e/portfolio-steps-integration.spec.ts",
    "test:e2e:pdf": "npm run test:e2e -- e2e/pdf-autofill.spec.ts",
    "test:e2e:all": "npm run test:e2e",
    "smoke:copilot": "tsx scripts/copilot-smoke.ts",
    "pilot:dry-run:start": "tsx scripts/run-pilot-dry-run.ts",
    "pilot:dry-run:functional": "tsx scripts/run-pilot-dry-run.ts --functional",
    "pilot:dry-run:functional:api": "tsx scripts/copilot-dry-run-functional.ts",
    "pilot:dry-run:resilience": "tsx scripts/copilot-dry-run-resilience.ts",
    "load:copilot": "tsx scripts/copilot-load-baseline.ts",
    "pilot:report:preflight": "tsx scripts/pilot/generate-copilot-pilot-report.ts --preflight",
    "pilot:report": "tsx scripts/pilot/generate-copilot-pilot-report.ts"
  },
  "prisma": {
    "seed": "npx tsx prisma/seed.ts"
  },
