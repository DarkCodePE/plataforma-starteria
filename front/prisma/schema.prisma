model Challenge {
  id                    String                  @id @default(cuid())
  strategicFrontId      String
  strategicFront        StrategicFront          @relation(fields: [strategicFrontId], references: [id], onDelete: Cascade)
  title                 String
  name                  String?
  description           String?
  type                  ChallengeType           @default(crecimiento)
  whatWeWantToMove      String?
  objective             String?
  whyNow                String?
  successCriteria       String?
  challengeOwner        String?
  challengeOwnerStatus  StakeholderStatus       @default(definido)
  sponsorStatus         StakeholderStatus       @default(definido)
  openCallStatus        ChallengeOpenCallStatus @default(inactiva)
  visibleToParticipants Boolean                 @default(false)
  publicationNotes      String?
  lastPublishedAt       DateTime?
  status                ChallengeStatus         @default(draft)
  // ADR-030: la pausa recuerda de donde vino. Sin esto, reanudar obligaria a adivinar
  // (vuelve a `activo_interno` o a `recibiendo_iniciativas`?) y se perderia contexto que
  // el sistema si tenia. Nullable: solo tiene valor mientras el reto esta pausado.
  pausedFromStatus      ChallengeStatus?
  activationMode        ChallengeActivationMode @default(convocatoria_abierta)
  coverageStatus        ChallengeCoverageStatus @default(sin_cobertura)
  // Autoria de la activacion del reto. Eran campos SOLO-front: se editaban en /portfolio
  // y se perdian al recargar porque no habia donde guardarlos (reconcileChallenge los
  // preservaba a mano del estado local para que adaptChallenge no los pisara con defaults).
  // Nullable y SIN default a proposito (leccion de ADR-029): una fila previa al cambio se
  // distingue de una que el usuario dejo vacia, y el orden de despliegue no decide correccion.
  // activationInputs es Json porque es un objeto fijo de 9 enums de autoria: no se filtra
  // ni se consulta por sus campos. Se valida en el borde con zod (portfolio.schemas.ts).
  activationInputs      Json?
  activationRecommendationNote String?
  activationMessageDraft       String?
  sponsorId             String?
  ownerId               String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  selectedPeople   ChallengeInvitation[]
  assignedSquad    ChallengeSquadMember[]
  challengeTeam    ChallengeTeamMember[] // ADR-023: unified reto-scoped team (replaces assignedSquad)
  initiativeMetas  InitiativePortfolioMeta[]
  overlaps         InitiativeOverlap[]
  executiveOutputs ExecutiveOutput[]
  handoffAssignments PortfolioHandoffAssignment[]

  @@index([strategicFrontId])
  @@index([status])
}

