// ─── Models ─────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(cuid())
  email               String    @unique
  name                String
  passwordHash        String?
  googleId            String?   @unique
  // ADR-029: `roles` es la fuente de autorización; un usuario puede pertenecer a
  // varias superficies a la vez (participante Y portfolio_lead), que es lo que un
  // escalar no sabe expresar. Los permisos efectivos son la UNIÓN de los roles.
  //
  // `role` SOBREVIVE durante la fase 1 y se sigue escribiendo en paralelo: el CD
  // corre `prisma db push` SIN `--accept-data-loss` (ADR-018), así que eliminar la
  // columna necesita ventana y comando propios. Hasta entonces es la red de
  // seguridad para revertir sin restaurar backups. Fase 2: issue #160.
  //
  // Array = aditivo, pasa el guard del CD. Lo prohibido por ADR-018/020/023/026
  // es el @@unique sobre tabla poblada; aquí no aparece.
  //
  // SIN @default A PROPÓSITO. Verificado contra Postgres: con `@default([participante])`
  // el ALTER TABLE rellena TODAS las filas existentes con ese valor, así que un admin
  // pasaba a `{participante}` y quedaba indistinguible de un participante real — si un
  // lector de `roles` llegase a producción antes del backfill, sería una purga silenciosa
  // de privilegios. Sin default, las filas viejas quedan en `{}`, que es una señal
  // INEQUÍVOCA de "aún no migrada" y permite caer a `role` (ver rolesForUser).
  // Así el orden de despliegue deja de ser una condición de corrección.
  role                Role
  roles               Role[]
  initials            String
  skills              String[]
  bio                 String?
  avatarUrl           String?
  isActive            Boolean   @default(true)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  cohortId            String?
  cohort              Cohort?   @relation(fields: [cohortId], references: [id])
  // ADR-022: primary B2B organization (denormalized convenience pointer). Plain
  // scalar (NOT a relation, NOT @unique) — additive & safe for `prisma db push`
  // (ADR-018). Authoritative membership lives in OrganizationMember.
  organizationId      String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  projects                 Project[]
  handoffAssignments       PortfolioHandoffAssignment[] @relation("HandoffCreatedBy")
  handoffMemberIdentities  PortfolioHandoffMember[] @relation("HandoffMemberUser")
  teamMemberships          TeamMember[]
  challengeTeamMemberships ChallengeTeamMember[] // ADR-023: reto-scoped team membership
  mentorSessions           MentorSession[]
  evidence                 Evidence[]
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  helpRequests             HelpRequest[]         @relation("HelpRequester")
  mentorHelpRequests       HelpRequest[]         @relation("HelpMentor")
  sponsorCheckpoints       SponsorCheckpoint[]   @relation("SponsorCheckpoints")
  initialReviews           InitialReview[] // ADR-025: revisiones iniciales del usuario
  portfolioLeadGovernance  InitiativeGovernance[] @relation("InitiativePortfolioLeadGovernance")
  portfolioAccessGrants    OrganizationPortfolioAccessGrant[] @relation("PortfolioAccessGrants")
  portfolioAccessGrantsIssued OrganizationPortfolioAccessGrant[] @relation("PortfolioAccessGrantIssuers")
  requestedDecisionRequests DecisionRequest[] @relation("DecisionRequestRequester")
  authorityDecisionRequests DecisionRequest[] @relation("DecisionRequestAuthorityUser")
  decidedOrganizationalDecisions Decision[] @relation("DecisionDecider")
    portfolioEntryConversions PortfolioEntryConversion[]
    portfolioEntryPortfolioContinuations PortfolioEntryPortfolioContinuation[]
    portfolioBootstrapSessions PortfolioBootstrapSession[]
    portfolioBootstrapImportBatches PortfolioBootstrapImportBatch[] @relation("PortfolioBootstrapImportBatchUploadedBy")
    confirmedPortfolioAnchors PortfolioAnchor[] @relation("PortfolioAnchorConfirmedBy")
    publishedPortfolioReadings PortfolioReading[]

  @@index([email])
  @@index([role])
  @@index([cohortId])
  @@index([googleId])
  @@index([organizationId])
  copilotConversations     CopilotConversation[]
}

model Project {
  id                      String            @id @default(cuid())
  name                    String
  description             String?
  status                  ProjectStatus     @default(DRAFT)
  currentStep             Int               @default(0)
  step0Status             Step0Status       @default(NOT_STARTED)
  step0Data               Json?
  // Set when this project was created by redeeming a pilot code (ADR-018).
  // Plain index (NOT @unique): adding a unique constraint trips `prisma db push`'s
  // data-loss guard and aborts the deploy. Idempotency is enforced in the claim
  // service instead (claim.createdProjectId + a findFirst guard before creating).
  pilotLeadId             String?
  mentorCredits           Int               @default(3)
  riskLevel               RiskLevel?
  isArchived              Boolean           @default(false)
  lastPosition            Json?
  sponsorTouchpoints      Json?
  sponsorComments         Json?
  // ADR-025: procedencia de la iniciativa + snapshot de la revisión inicial que la
  // originó (nullable → additivo, seguro para `prisma db push`).
  origin                  InitiativeOrigin? @default(from_scratch)
  initialReviewSnapshotId String?
  createdAt               DateTime          @default(now())
  lastModified            DateTime          @updatedAt

  ownerId  String
  owner    User    @relation(fields: [ownerId], references: [id])
  cohortId String?
  cohort   Cohort? @relation(fields: [cohortId], references: [id])

  steps                 Step[]
  evidence              Evidence[]
  sourceRefs            SourceRef[]
  truthClaims           TruthClaim[]
  truthValidations      TruthValidation[]
  attentionItems        AttentionItem[]
  impactAssertions      ImpactAssertion[]
  teamMembers           TeamMember[]
  mentorSessions        MentorSession[]
  helpRequests          HelpRequest[]
  sponsorCheckpoints    SponsorCheckpoint[]
  portfolioMeta         InitiativePortfolioMeta[]
  initiativePdfs        InitiativePdf[]
  initialReviewSnapshot InitialReviewSnapshot?      @relation("ProjectFromSnapshot", fields: [initialReviewSnapshotId], references: [id])
  routeConfirmation     RouteConfirmation?          @relation("ProjectRouteConfirmation")
  portfolioEntryConversion PortfolioEntryConversion?
  contextSources        ContextSource[]
  contextSnapshots      InitiativeContextSnapshot[]
  contextNotes          InitiativeContextNote[]
  adaptiveStepConfigurations AdaptiveStepConfiguration[]
  adaptiveCheckpointInstances AdaptiveCheckpointInstance[]
  adaptiveCheckpointResponses AdaptiveCheckpointResponse[]
  adaptiveStepOutputs AdaptiveStepOutput[]
  adaptiveProgressSignal AdaptiveProgressSignal?
  adaptiveEvents AdaptiveAdaptationEvent[]
  initiativeCycles InitiativeCycle[]
  criticalChanges CriticalChange[]
  initiativeGovernance InitiativeGovernance?
  decisionRequests DecisionRequest[]
  decisions Decision[]
  continuationRoutes ContinuationRoute[]
  implementationHandoffs ImplementationHandoff[]
  scalingHandoffs ScalingHandoff[]
  closureSummaries ClosureSummary[]
  handoffAssignments PortfolioHandoffAssignment[]

  @@index([ownerId])
  @@index([cohortId])
  @@index([status])
  @@index([pilotLeadId])
  // Plain @@index (NOT @@unique): igual que `pilotLeadId`, agregar un @@unique a una
  // tabla EXISTENTE dispara el guard de data-loss de `prisma db push` y aborta el deploy
  // (el CD corre db push SIN --accept-data-loss). La idempotencia real (un snapshot →
  // ≤1 Project, RB-IR-017/018) ya la garantizan RouteConfirmation.reviewId @@unique + el
  // claim-antes-de-crear en RouteConfirmationService, así que el unique aquí era redundante.
  @@index([initialReviewSnapshotId])
}

model Step {
  id        String     @id @default(cuid())
  projectId String
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  number    Int
  name      String
  status    StepStatus @default(BLOCKED)
  progress  Int        @default(0)
  stepData  Json?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  modules       Module[]
  runs          Run[]
  feedbackIA    FeedbackIA[]
  mentorSession MentorSession?

  @@unique([projectId, number])
  @@index([projectId])
}

model Module {
  id        String       @id @default(cuid())
  stepId    String
  step      Step         @relation(fields: [stepId], references: [id], onDelete: Cascade)
  moduleId  String
  name      String
  status    ModuleStatus @default(BLOCKED)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  @@unique([stepId, moduleId])
  @@index([stepId])
}

model AdaptiveStepConfiguration {
  id                String   @id @default(cuid())
  projectId         String
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleId           String
  cycle             InitiativeCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  stepNumber        Int
  version           Int
  status            String   @default("active")
  routeType         String
  depthLevel        String
  maturity          String?
  configurationJson Json
  sourceContextJson Json?
  requiresReview    Boolean  @default(false)
  supersededById    String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  checkpointInstances AdaptiveCheckpointInstance[]
  stepOutputs         AdaptiveStepOutput[]

  @@unique([cycleId, stepNumber, version])
  @@index([projectId])
  @@index([cycleId])
  @@index([cycleId, stepNumber])
  @@index([projectId, stepNumber, status])
}

model AdaptiveCheckpointInstance {
  id                     String   @id @default(cuid())
  projectId              String
  project                Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleId                String
  cycle                  InitiativeCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  stepConfigurationId    String
  stepConfiguration      AdaptiveStepConfiguration @relation(fields: [stepConfigurationId], references: [id], onDelete: Cascade)
  stepNumber             Int
  checkpointKey          String
  sequence               Int
  status                 String   @default("ready")
  materializedQuestionsJson Json
  sufficiencyJson        Json?
  startedAt              DateTime @default(now())
  completedAt            DateTime?
  idempotencyKey         String?  @unique
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  responses AdaptiveCheckpointResponse[]

  @@unique([cycleId, stepConfigurationId, checkpointKey], map: "ACI_cycle_config_checkpoint_key")
  @@index([projectId])
  @@index([cycleId])
  @@index([cycleId, stepNumber])
  @@index([projectId, status])
}

model AdaptiveCheckpointResponse {
  id                   String   @id @default(cuid())
  projectId            String
  project              Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  checkpointInstanceId String
  checkpointInstance   AdaptiveCheckpointInstance @relation(fields: [checkpointInstanceId], references: [id], onDelete: Cascade)
  checkpointKey        String
  responseJson         Json
  answeredById         String?
  idempotencyKey       String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([projectId])
  @@index([checkpointInstanceId])
}

model AdaptiveStepOutput {
  id                    String   @id @default(cuid())
  projectId             String
  project               Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleId               String
  cycle                 InitiativeCycle @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  sourceConfigurationId String?
  sourceConfiguration   AdaptiveStepConfiguration? @relation(fields: [sourceConfigurationId], references: [id], onDelete: SetNull)
  stepNumber            Int
  version               Int
  status                String   @default("draft")
  outputKey             String
  outputJson            Json
  confirmedById         String?
  confirmedAt           DateTime?
  requiresReview        Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([cycleId, stepNumber, version])
  @@index([projectId])
  @@index([cycleId])
  @@index([cycleId, stepNumber])
  @@index([projectId, stepNumber, status])
}

model AdaptiveProgressSignal {
  id            String   @id @default(cuid())
  projectId     String   @unique
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleId       String?
  cycle         InitiativeCycle? @relation(fields: [cycleId], references: [id], onDelete: SetNull)
  stepNumber    Int
  checkpointKey String?
  health        String
  signalJson    Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([cycleId])
}

model InitiativeCycle {
  id              String           @id @default(cuid())
  projectId       String
  project         Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  cycleNumber     Int
  parentCycleId   String?
  parentCycle     InitiativeCycle? @relation("CycleParent", fields: [parentCycleId], references: [id], onDelete: SetNull)
  childCycles     InitiativeCycle[] @relation("CycleParent")
  basedOnCycleId  String?
  basedOnCycle    InitiativeCycle? @relation("CycleBasis", fields: [basedOnCycleId], references: [id], onDelete: SetNull)
  derivedCycles   InitiativeCycle[] @relation("CycleBasis")
  triggerType     CycleTriggerType @default(initial)
  triggerRefId    String?
  startStep       Int              @default(0)
  currentStep     Int              @default(0)
  status          CycleStatus      @default(active)
  startedAt       DateTime         @default(now())
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  stepStates              CycleStepState[]
  stepConfigurations      AdaptiveStepConfiguration[]
  checkpointInstances     AdaptiveCheckpointInstance[]
  stepOutputs             AdaptiveStepOutput[]
  progressSignals         AdaptiveProgressSignal[]
  sourceCriticalChanges   CriticalChange[] @relation("CriticalChangeSourceCycle")
  resultingCriticalChanges CriticalChange[]             @relation("CriticalChangeResultingCycle")
  basedOnCriticalChanges  CriticalChange[] @relation("CriticalChangeBasedOnCycle")
  decisionRequests        DecisionRequest[]
  decisions               Decision[]
  resultingContinuationRoutes ContinuationRoute[]

  @@unique([projectId, cycleNumber])
  @@index([projectId])
  @@index([projectId, status])
}

model CycleStepState {
  id                    String              @id @default(cuid())
  cycleId               String
  cycle                 InitiativeCycle     @relation(fields: [cycleId], references: [id], onDelete: Cascade)
  stepNumber            Int
  state                 CycleStepStateValue
  inheritedFromCycleId  String?
  inheritedFromOutputId String?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([cycleId, stepNumber])
  @@index([cycleId])
  @@index([cycleId, stepNumber])
}

model CriticalChange {
  id                   String               @id @default(cuid())
  projectId            String
  project              Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceCycleId        String
  sourceCycle          InitiativeCycle      @relation("CriticalChangeSourceCycle", fields: [sourceCycleId], references: [id], onDelete: Restrict)
  resultingCycleId     String?
  resultingCycle       InitiativeCycle?     @relation("CriticalChangeResultingCycle", fields: [resultingCycleId], references: [id], onDelete: SetNull)
  basedOnCycleId       String?
  basedOnCycle         InitiativeCycle?     @relation("CriticalChangeBasedOnCycle", fields: [basedOnCycleId], references: [id], onDelete: SetNull)
  detectedAtStep       Int
  changeScope          CriticalChangeScope
  field                String?
  status               CriticalChangeStatus @default(detected)
  proposedById         String
  confirmedById        String?
  confirmedAt          DateTime?
  appliedAt            DateTime?
  proposedReentryStep  Int?
  confirmedReentryStep Int?
  idempotencyKey       String               @unique
  previousValueJson    Json?
  nextValueJson        Json
  impactJson           Json?
  reason               String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([projectId])
  @@index([sourceCycleId])
  @@index([resultingCycleId])
  @@index([basedOnCycleId])
  @@index([projectId, status])
}

model InitiativeGovernance {
  id                  String         @id @default(cuid())
  projectId           String         @unique
  project             Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
