# ---- Stage 1: Build ----
FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS build

WORKDIR /app

# Copy package manifests first for better Docker layer caching
COPY front/package.json front/package-lock.json ./
# package-lock.json resolves xlsx from a vendored tarball (file:vendor/...),
# so the vendor dir must land next to the manifests or `npm ci` fails ENOENT.
COPY front/vendor ./vendor

# Install the exact dependency graph captured in package-lock.json. npm resolves
# the locked React peers during `ci`; a second mutable install would weaken
# reproducibility and could silently rewrite the graph inside the build layer.
RUN npm ci

# Copy source code and config files needed for the build
COPY front/index.html ./
COPY front/vite.config.ts ./
COPY front/postcss.config.mjs ./
COPY front/src/ ./src/

# Vite envs must be present at build time (prefixed VITE_*) — they get baked into the bundle.
# Default to /api/v1 (relative): in prod the frontend's nginx proxies /api/ to
# starteria-backend:3001 (see k8s/nginx.conf), so the SPA stays same-origin and
# avoids CORS entirely. Override via --build-arg VITE_API_URL=... for staging.
ARG VITE_API_URL=/api/v1
ARG VITE_FEATURE_PDF_AUTOFILL=true
ARG VITE_ENABLE_DEMO_DATA=false
ARG VITE_ENABLE_INITIAL_REVIEW=false
ARG VITE_ENABLE_INITIATIVE_REVIEW_CHAT=true
ARG VITE_PORTFOLIO_COPILOT_ENABLED=false
ARG VITE_STEP_REASONING_COPILOT_ENABLED=false
ARG VITE_PORTFOLIO_GOAL_E2_LEDGER_UI_ENABLED=false
ARG VITE_PORTFOLIO_GOAL_E2_MULTI_TURN_UI_ENABLED=false
ARG VITE_PORTFOLIO_GOAL_E2_CHECKPOINT_UI_ENABLED=false
ARG STARTERIA_RELEASE_SHA=unknown
ARG STARTERIA_RELEASE_VERSION=0.0.1
# Google Identity Services client id. Empty = Google login button hidden.
# cd.yml passes it from the GOOGLE_CLIENT_ID GH Secret.
ARG VITE_GOOGLE_CLIENT_ID=
ENV VITE_API_URL=$VITE_API_URL
ENV VITE_FEATURE_PDF_AUTOFILL=$VITE_FEATURE_PDF_AUTOFILL
ENV VITE_ENABLE_DEMO_DATA=$VITE_ENABLE_DEMO_DATA
ENV VITE_ENABLE_INITIAL_REVIEW=$VITE_ENABLE_INITIAL_REVIEW
ENV VITE_ENABLE_INITIATIVE_REVIEW_CHAT=$VITE_ENABLE_INITIATIVE_REVIEW_CHAT
ENV VITE_PORTFOLIO_COPILOT_ENABLED=$VITE_PORTFOLIO_COPILOT_ENABLED
ENV VITE_STEP_REASONING_COPILOT_ENABLED=$VITE_STEP_REASONING_COPILOT_ENABLED
ENV VITE_PORTFOLIO_GOAL_E2_LEDGER_UI_ENABLED=$VITE_PORTFOLIO_GOAL_E2_LEDGER_UI_ENABLED
ENV VITE_PORTFOLIO_GOAL_E2_MULTI_TURN_UI_ENABLED=$VITE_PORTFOLIO_GOAL_E2_MULTI_TURN_UI_ENABLED
ENV VITE_PORTFOLIO_GOAL_E2_CHECKPOINT_UI_ENABLED=$VITE_PORTFOLIO_GOAL_E2_CHECKPOINT_UI_ENABLED
ENV STARTERIA_RELEASE_SHA=$STARTERIA_RELEASE_SHA
ENV STARTERIA_RELEASE_VERSION=$STARTERIA_RELEASE_VERSION
ENV VITE_GOOGLE_CLIENT_ID=$VITE_GOOGLE_CLIENT_ID

# Build the production bundle
RUN npm run build
RUN node -e "const fs=require('node:fs'); const flag=(name)=>process.env[name]==='true'; fs.writeFileSync('dist/release.json', JSON.stringify({sourceSha:process.env.STARTERIA_RELEASE_SHA,version:process.env.STARTERIA_RELEASE_VERSION,flags:{VITE_API_URL:process.env.VITE_API_URL,VITE_FEATURE_PDF_AUTOFILL:flag('VITE_FEATURE_PDF_AUTOFILL'),VITE_ENABLE_DEMO_DATA:flag('VITE_ENABLE_DEMO_DATA'),VITE_ENABLE_INITIAL_REVIEW:flag('VITE_ENABLE_INITIAL_REVIEW'),VITE_ENABLE_INITIATIVE_REVIEW_CHAT:flag('VITE_ENABLE_INITIATIVE_REVIEW_CHAT'),VITE_PORTFOLIO_COPILOT_ENABLED:flag('VITE_PORTFOLIO_COPILOT_ENABLED'),VITE_STEP_REASONING_COPILOT_ENABLED:flag('VITE_STEP_REASONING_COPILOT_ENABLED'),VITE_PORTFOLIO_GOAL_E2_LEDGER_UI_ENABLED:flag('VITE_PORTFOLIO_GOAL_E2_LEDGER_UI_ENABLED'),VITE_PORTFOLIO_GOAL_E2_MULTI_TURN_UI_ENABLED:flag('VITE_PORTFOLIO_GOAL_E2_MULTI_TURN_UI_ENABLED'),VITE_PORTFOLIO_GOAL_E2_CHECKPOINT_UI_ENABLED:flag('VITE_PORTFOLIO_GOAL_E2_CHECKPOINT_UI_ENABLED'),VITE_GOOGLE_LOGIN_ENABLED:Boolean(process.env.VITE_GOOGLE_CLIENT_ID)}},null,2)+'\n')"

# ---- Stage 2: Serve ----
FROM nginx:alpine@sha256:a3554c0d0b48177b1413c26e01f695334428020d9df01243fbae3e11cfd17417

ARG STARTERIA_RELEASE_SHA=unknown
ARG STARTERIA_RELEASE_VERSION=0.0.1
LABEL org.opencontainers.image.revision=$STARTERIA_RELEASE_SHA \
      org.opencontainers.image.version=$STARTERIA_RELEASE_VERSION \
      org.opencontainers.image.source="https://github.com/DarkCodePE/plataforma-starteria"

# Remove the default nginx config
RUN rm /etc/nginx/conf.d/default.conf

# Copy custom nginx config for SPA routing
COPY k8s/nginx.conf /etc/nginx/conf.d/default.conf

# Copy built assets from the build stage
COPY --from=build /app/dist /usr/share/nginx/html
RUN test -s /usr/share/nginx/html/release.json

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
