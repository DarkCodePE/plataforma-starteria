# Root env consumed by docker-compose.yml
# Copy to `.env` (already git-ignored) and fill the required values.

# === REQUIRED ===
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# === OPTIONAL (have sensible defaults) ===
NODE_ENV=production
POSTGRES_DB=starteria_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/starteria_db
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
VITE_ENABLE_INITIAL_REVIEW=false

# KAN-204: disabled by default. QA uses an explicit synthetic user allowlist and
# the deterministic backend provider; never place credentials in these values.
VITE_STEP_REASONING_COPILOT_ENABLED=false
VITE_STEP_REASONING_QA_USER_IDS=
STEP_REASONING_COPILOT_ENABLED=false
STEP_REASONING_QA_USER_IDS=
STEP_REASONING_PROVIDER_MODE=qa_stub

# Company context extraction guardrails
CONTEXT_SOURCE_MAX_BYTES=20971520
CONTEXT_WEB_MAX_BYTES=1500000
CONTEXT_WEB_TIMEOUT_MS=10000
CONTEXT_WEB_MAX_REDIRECTS=3
