OPENROUTER_API_KEY=your_key_here
JEV_API_KEY=your_jev_key_here
# INTERPRET defaults to Jev; set to llm to use the previous OpenRouter backend.
# HARNESS_INTERPRET_BACKEND=llm
ENVIRONMENT=development
LOG_LEVEL=INFO
MAX_COST_PER_REQUEST_USD=0.05
MAX_COST_PER_PROJECT_DAY_USD=2.00
# Optional First Value P3 model override; defaults to deepseek/deepseek-v4-flash.
# FIRST_VALUE_P3_MODEL=deepseek/deepseek-v4-flash
